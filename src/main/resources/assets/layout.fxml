<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Tres columnes: àrea de dibuix | formulari i colors | llista d'objectes -->
<HBox xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.Controller">
    <children>

        <!-- Columna 1: àrea de dibuix -->
        <Canvas fx:id="canvas" width="600.0" height="500.0" />

        <!-- Columna 2: formulari d'estil (a dalt) i colors predefinits (a baix) -->
        <VBox spacing="8.0" prefWidth="180.0" style="-fx-background-color: #eeeeee;">
            <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
            <children>
                <!-- Selector d'eina -->
                <Label text="Eina" style="-fx-font-weight: bold;" />
                <fx:define>
                    <ToggleGroup fx:id="toolGroup" />
                </fx:define>
                <RadioButton fx:id="freeRadio" text="Traç lliure" toggleGroup="$toolGroup" selected="true" />
                <RadioButton fx:id="lineRadio" text="Línia" toggleGroup="$toolGroup" />
                <RadioButton fx:id="rectRadio" text="Rectangle" toggleGroup="$toolGroup" />

                <Separator />

                <!-- Opcions de dibuix -->
                <Label text="Color de línia" style="-fx-font-weight: bold;" />
                <ColorPicker fx:id="strokePicker" maxWidth="Infinity" />

                <Label text="Color d'emplenament" style="-fx-font-weight: bold;" />
                <ColorPicker fx:id="fillPicker" maxWidth="Infinity" />

                <Label text="Ample de línia" style="-fx-font-weight: bold;" />
                <Spinner fx:id="widthSpinner" min="1" max="50" initialValue="3" editable="true" maxWidth="Infinity" />

                <!-- Empeny els colors cap a baix -->
                <Region VBox.vgrow="ALWAYS" />
                <Separator />

                <!-- Colors predefinits (es dibuixen amb un Canvas propi) -->
                <Label text="Colors" style="-fx-font-weight: bold;" />
                <Canvas fx:id="colorsCanvas" width="160.0" height="110.0" />
            </children>
        </VBox>

        <!-- Columna 3: llista d'objectes dibuixats -->
        <VBox spacing="8.0" prefWidth="180.0">
            <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
            <children>
                <Label text="Objectes" style="-fx-font-weight: bold;" />
                <ListView fx:id="objectsList" VBox.vgrow="ALWAYS" />
                <Button fx:id="deleteButton" text="Eliminar" maxWidth="Infinity" onAction="#actionDelete" />
            </children>
        </VBox>

    </children>
</HBox>
