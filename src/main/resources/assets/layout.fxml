<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.Controller">
    <children>

        <!-- Left: drawing area -->
        <Canvas fx:id="canvas" width="600.0" height="500.0" />

        <!-- Center: tools -->
        <VBox spacing="6.0" prefWidth="240.0" style="-fx-background-color: #eeeeee;">
            <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
            <children>
                <Label text="Eina" style="-fx-font-weight: bold;" />
                <fx:define>
                    <ToggleGroup fx:id="toolGroup" />
                </fx:define>
                <RadioButton fx:id="strokeRadio" text="Traç lliure" toggleGroup="$toolGroup" selected="true" onMouseClicked="#onToolClicked" />
                <RadioButton fx:id="lineRadio" text="Línia" toggleGroup="$toolGroup" onMouseClicked="#onToolClicked" />
                <RadioButton fx:id="rectRadio" text="Rectangle" toggleGroup="$toolGroup" onMouseClicked="#onToolClicked" />

                <Label text="Color de línia" style="-fx-font-weight: bold;" />
                <ColorPicker fx:id="colorPicker" />
                <Label text="Color d'emplenament" style="-fx-font-weight: bold;" />
                <ColorPicker fx:id="fillPicker" />
                <Label text="Ample" style="-fx-font-weight: bold;" />
                <Spinner fx:id="widthSpinner" min="1" max="50" initialValue="2" />

                <!-- Push the colors to the bottom -->
                <Region VBox.vgrow="ALWAYS" />
                <Separator />

                <!-- Bottom: predefined colors -->
                <Label text="Colors" style="-fx-font-weight: bold;" />
                <Canvas fx:id="colorsCanvas" width="216.0" height="150.0" />
            </children>
        </VBox>

        <!-- Right: objects list -->
        <VBox spacing="6.0" prefWidth="180.0">
            <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
            <children>
                <Label text="Objectes" style="-fx-font-weight: bold;" />
                <ListView fx:id="objectsList" VBox.vgrow="ALWAYS" />
                <Button fx:id="deleteButton" text="Eliminar" onAction="#actionDelete" />
            </children>
        </VBox>

    </children>
</HBox>
